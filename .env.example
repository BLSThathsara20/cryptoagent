POSTGRES_USER=cryptoagent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cryptoagent
POSTGRES_HOST=db
POSTGRES_PORT=5432

# AI Provider — use OpenAI (recommended, cheaper) or Claude
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_MONTHLY_BUDGET_USD=5

# Optional — only if LLM_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

BINANCE_API_KEY=
BINANCE_SECRET=
COINGLASS_API_KEY=

LIVE_MODE=false
STARTING_BALANCE=10000
AGENT_LOOP_INTERVAL=300
MAX_RISK_PERCENT=2
WATCH_COINS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,AVAX,DOT,LINK

# Fund Manager Agent
FUND_RESERVE_PERCENT=30
MAX_ALLOCATION_PER_COIN=25
DAILY_PROFIT_TARGET_PERCENT=0.5

# Short-hold trading (not overnight swings)
MAX_OPEN_TRADES=2
MAX_HOLD_MINUTES=30
TRADE_SL_PERCENT=0.8
TRADE_TP_PERCENT=1.2
MIN_CONFIDENCE_TO_TRADE=55
STOP_NEW_TRADES_WHEN_TARGET_HIT=true

# OpenAI cost control — selective = rules first, LLM only when ambiguous
LLM_MODE=selective
LLM_COOLDOWN_SEC=900
LLM_MIN_SIGNAL=25
LLM_STRONG_SIGNAL=45
LLM_MAX_TOKENS=350

# Long-run data retention (prevents DB growing forever)
RETAIN_ORDERBOOK_DAYS=7
RETAIN_LIVE_TRADES_DAYS=7
RETAIN_COIN_PRICES_DAYS=90
RETAIN_MARKET_META_DAYS=90
RETAIN_ALERTS_DAYS=30
RETAIN_PORTFOLIO_SNAPSHOTS_DAYS=30
RETAIN_NEWS_DAYS=14
RETAIN_FEATURE_SNAPSHOTS=2000
RETAIN_PAPER_PNL_DAYS=180
RETAIN_LLM_MONTHLY_MONTHS=4

# Autopilot (all automatic — no manual steps)
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_RETAIN_COUNT=14
BACKUP_DIR=/backups
AUTO_RECOVERY_ENABLED=true
DB_SIZE_WARN_MB=3000
